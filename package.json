{
  "name": "callflow",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "tunnel": "node scripts/tunnel.mjs",
    "build": "next build",
    "start": "node -e \"const{execSync}=require('child_process');const port=3000;let k=0;if(process.platform==='win32'){try{const out=execSync('netstat -ano | findstr :'+port+' | findstr LISTENING').toString();const pids=[...new Set(out.split('\\n').map(function(l){return l.trim().split(' ').filter(Boolean).pop()}).filter(function(p){return p&&p!=='0'}))];pids.forEach(function(pid){try{execSync('taskkill /F /T /PID '+pid);k++}catch(e){}})}catch(e){}}else{try{execSync('fuser -k '+port+'/tcp');k++}catch(e){}}console.log('[npm start] cleared port '+port+' ('+k+' listener(s) killed)');\" && next start -p 3000",
    "lint": "eslint",
    "test": "vitest run",
    "test-email": "node scripts/test-email.cjs",
    "last-calls": "node scripts/last-calls.cjs",
    "seed-test": "node scripts/seed-test.cjs",
    "clear-test": "node scripts/clear-test.cjs",
    "link-calls": "node scripts/link-calls.cjs",
    "activate-pilot": "node scripts/activate-pilot.cjs",
    "test:browser": "node scripts/browser-test-setup.mjs",
    "test:build": "next build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dodopayments": "^2.51.0",
    "dodopayments-checkout": "^1.9.9",
    "firebase-admin": "^14.3.0",
    "libphonenumber-js": "^1.13.13",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "nodemailer": "^10.0.16",
    "openai": "^7.21.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "standardwebhooks": "^1.1.1",
    "watchpack": "2.5.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "allowScripts": {}
}
