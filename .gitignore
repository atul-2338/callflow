# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/dist/

# production
/build

# call recordings (local audio files — never commit)
/recordings/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local status report (contains real customer phone numbers — not for public repos)
/project-status.log

# local day job logs
/worklog-*.md

# local dev server capture
/dev_server.log

# local CRM data (contains Twilio credentials)
/data/*.json

# SQLite database files (live DB never committed; only migrations/ is)
/data/*.db
/data/*.db-*
*.db
*.db-*
*.sqlite
*.sqlite3

# local tooling binaries
/tools/

# local Kilo/agent config (contains API keys — never commit)
/.kilo/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
