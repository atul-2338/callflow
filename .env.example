# --- SignalWire (Voice IVR + SMS) ---
SIGNALWIRE_PROJECT_ID="PASTE_YOUR_PROJECT_ID"
SIGNALWIRE_API_TOKEN="PASTE_YOUR_API_TOKEN"
SIGNALWIRE_SPACE_URL="https://your-space.signalwire.com"
SIGNALWIRE_FROM_NUMBER="+1xxx"

# Number to forward inbound calls to (owner's phone) — leave empty for voicemail-only mode
BUSINESS_OWNER_NUMBER=""

# --- Firebase Cloud Messaging (push notifications) ---
# Service account JSON (single line, or base64-encoded JSON) from the
# Firebase console → Project settings → Service accounts.
FIREBASE_SERVICE_ACCOUNT="PASTE_YOUR_SERVICE_ACCOUNT_JSON"

# --- Optional: shared secret to protect write APIs ---
# APP_AUTH_TOKEN="your-secret-token"

# --- Plivo (call-forwarding verification) ---
# PLIVO_AUTH_ID="PASTE_YOUR_PLIVO_AUTH_ID"
# PLIVO_AUTH_TOKEN="PASTE_YOUR_PLIVO_AUTH_TOKEN"
# PLIVO_NUMBER="+1xxx"

# Public base URL of this app — used to build the Plivo answer webhook URL and
# required when verifying forwarding through a tunnel (e.g. ngrok). Plivo must
# be able to reach this URL, so "http://localhost:3000" will NOT work:
# PUBLIC_BASE_URL="https://your-ngrok-host"

# --- CORS for onboarding endpoints (comma-separated origins, or * ) ---
# CORS_ORIGINS="https://app.example.com,https://admin.example.com"
