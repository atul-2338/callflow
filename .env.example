# --- Firebase Cloud Messaging (push notifications) ---
# Service account JSON (single line, or base64-encoded JSON) from the
# Firebase console → Project settings → Service accounts.
FIREBASE_SERVICE_ACCOUNT="PASTE_YOUR_SERVICE_ACCOUNT_JSON"

# --- Optional: shared secret to protect write APIs ---
# LEAVE UNSET AT LAUNCH: setting it makes the dashboard's own writes fail with
# 401 until a token UI exists (see "Auth" in README.md). Unset = writes are open.
# APP_AUTH_TOKEN="your-secret-token"

# --- Plivo (call-forwarding verification) ---
# PLIVO_AUTH_ID="PASTE_YOUR_PLIVO_AUTH_ID"
# PLIVO_AUTH_TOKEN="PASTE_YOUR_PLIVO_AUTH_TOKEN"
# PLIVO_NUMBER="+1xxx"

# --- Dograh end-of-call webhook (/api/webhooks/dograh) ---
# Shared secret the Dograh workflow's webhook node sends back to Callflow.
# Configure in Dograh: URL https://<host>/api/webhooks/dograh?key=<SECRET>
# or custom header  X-Callflow-Secret: <SECRET>  (see "Dograh webhook" in
# README.md for the full payload template).
# UNSET = the endpoint accepts any POST — fine for the first local smoke
# tests, set a real value before pointing live calls at it.
# DOGRAH_WEBHOOK_SECRET="generate-a-long-random-string"

# --- Dodo Payments (server-side billing; test mode by default) ---
# Subscriptions are created through hosted Checkout Sessions
# (client.checkoutSessions.create). Dodo's direct subscription/payment-link
# endpoints are deprecated upstream and are not used here.
# Keys are mode-specific: a test key (`dodo_test_...`) only works in test_mode.
# DODO_PAYMENTS_API_KEY="dodo_test_..."
# DODO_PAYMENTS_ENVIRONMENT="test_mode" # set live_mode only after production validation
# DODO_SOLO_PRODUCT_ID="pdt_..."
# Where Dodo returns the customer after checkout. Must be /checkout/return: that
# page reports what the verified webhook stored and never grants access itself.
# DODO_PAYMENTS_RETURN_URL="https://your-app.example/checkout/return"
# Optional. Defaults to the origin of DODO_PAYMENTS_RETURN_URL + /onboarding.
# DODO_PAYMENTS_CANCEL_URL="https://your-app.example/onboarding"
# DODO_PAYMENTS_WEBHOOK_SECRET="whsec_..."
# BUSINESS_SESSION_SECRET="generate-a-long-random-secret"

# Register https://your-app.example/api/webhooks/dodo in Dodo Dashboard →
# Developer → Webhooks. Subscribe at minimum to: subscription.active,
# subscription.updated, subscription.past_due, subscription.on_hold,
# subscription.cancelled, subscription.failed, subscription.expired,
# payment.succeeded, and payment.failed. The URL must be reachable from Dodo —
# locally, that means running the tunnel in tools/ and using its https host.

# Public base URL of this app — used to build the Plivo verification-call answer
# URL (Plivo must reach it, so "http://localhost:3000" will NOT work). Read by
# /api/onboarding/verify. Set it to your ngrok/tunnel host or callflow.biz.
# PUBLIC_BASE_URL="https://your-ngrok-host"

# --- CORS for API endpoints (comma-separated origins, or * ) ---
# Unset = "*" (any site's browser JS may call the API). Set an explicit list
# before going live. Matching is an exact string compare: no trailing slashes.
# Value to use in production, VPS or Render (see "Deploying" in README.md):
# CORS_ORIGINS="https://callflow.biz,https://www.callflow.biz"
# http://localhost:3000 is NOT needed here: the dashboard fetches /api/... from
# its own origin, and same-origin requests are not subject to CORS at all.
# Caveat: CORS limits browser JS from OTHER sites only. It authenticates nothing,
# so while APP_AUTH_TOKEN is unset the write endpoints remain reachable from
# non-browser clients no matter what this says.
# CORS_ORIGINS="*"

# --- SQLite database location ---
# Path to the database file. Defaults to ./data/callflow.db when unset, which is
# all you need for local dev AND for a local production test (npm run build &&
# npm run start behind a tunnel) — no DATABASE_PATH required.
# On hosts whose disk is wiped by every redeploy (Render, Vercel, Fly, Heroku,
# Kubernetes — auto-detected) the app refuses to open the database in production
# unless this is an absolute path OUTSIDE the project directory, so a bad value
# fails loudly with a 500 instead of quietly losing data (src/lib/database.ts).
# Running production mode on a host that is not auto-detected (e.g. this VPS) does
# NOT trigger that check by itself; opt in with DB_REQUIRE_PERSISTENT_PATH=1 to
# keep it. deploy/systemd/callflow.service sets that flag, so the VPS is protected.
# On the VPS, deploy/vps-bootstrap.sh writes the /var/data value below for you:
# DATABASE_PATH="./data/callflow.db"   # local dev only
# DATABASE_PATH="/var/data/callflow.db"
# DB_REQUIRE_PERSISTENT_PATH=1

# --- Debug logging ---
# Set to 1 (or true) to enable verbose console logging from src/lib. Unset by default.
# DEBUG=1
