# --- Firebase Cloud Messaging (push notifications) ---
# Service account JSON (single line, or base64-encoded JSON) from the
# Firebase console → Project settings → Service accounts.
FIREBASE_SERVICE_ACCOUNT="PASTE_YOUR_SERVICE_ACCOUNT_JSON"

# --- Email (nodemailer over SMTP; NOT used by the Dograh webhook) ---
# New-call owner alerts are PUSH-ONLY (FCM): the Dograh webhook no longer
# sends email. These values remain for local email tooling
# (scripts/test-email.cjs) and any future email feature.
# All five values are required: if any is missing, the alert is skipped and a
# single warning is logged (the call is still saved and pushed as usual, and
# an email failure can never make the webhook fail).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="Callflow <you@gmail.com>"

# --- Optional: shared secret to protect write APIs ---
# LEAVE UNSET AT LAUNCH: setting it makes the dashboard's own writes fail with
# 401 until a token UI exists (see "Auth" in README.md). Unset = writes are open.
# APP_AUTH_TOKEN="your-secret-token"

# --- Plivo (LEGACY, not in use) ---
# Plivo is stale; the live provider is Telnyx (see the Telnyx block below).
# Old code under src/app/api/plivo is unused and stays unwired.
# PLIVO_AUTH_ID="PASTE_YOUR_PLIVO_AUTH_ID"
# PLIVO_AUTH_TOKEN="PASTE_YOUR_PLIVO_AUTH_TOKEN"
# PLIVO_NUMBER="+1xxx"

# --- Telnyx (inbound call forwarding to the Dograh agent) ---
# The Telnyx number receives the business's forwarded missed calls. Telnyx
# POSTs a `call.initiated` webhook to /api/v1/telephony/telnyx/answer, which
# verifies the Ed25519 signature and transfers the call to TELNYX_FORWARD_TO
# (the Dograh agent number) via the Call Control API.
# TELNYX_API_KEY="PASTE_YOUR_TELNYX_API_KEY"
# TELNYX_PUBLIC_KEY="PASTE_YOUR_TELNYX_PUBLIC_KEY"  # Mission Control → API Keys → Public Key
# TELNYX_NUMBER="+1xxx"
# TELNYX_FORWARD_TO="+1xxx"

# --- CallFlow forwarding DID (shown in the setup wizard) ---
# The CallFlow-owned number (E.164) that business phones forward missed calls
# to. Served to the onboarding wizard by GET /api/setup/config, which builds
# the carrier dial codes and "our number" display from it. Must be the same
# carrier-facing number as the live TELNYX_NUMBER — keep them in sync.
# Unset or invalid = the wizard shows an error state (the endpoint answers
# 503) instead of dial codes pointing at a wrong or dead number.
# CALLFLOW_FORWARDING_DID="+19283319394"

# --- Dograh end-of-call webhook (/api/webhooks/dograh) ---
# Shared secret the Dograh workflow's webhook node sends in the
# `x-webhook-secret` header. Set the SAME value here and in the Dograh
# dashboard (workflow editor → End Call → send webhook node → custom header).
# Comparison is constant-time; a wrong or missing secret on either side is
# rejected with 401 (fail closed). See "Webhook contract" in README.md.
WEBHOOK_SECRET=

# --- Dodo Payments (server-side billing; test mode by default) ---
# Subscriptions are created through hosted Checkout Sessions
# (client.checkoutSessions.create). Dodo's direct subscription/payment-link
# endpoints are deprecated upstream and are not used here.
# Keys are mode-specific: a test key (`dodo_test_...`) only works in test_mode.
# DODO_PAYMENTS_API_KEY="dodo_test_..."
# DODO_PAYMENTS_ENVIRONMENT="test_mode" # set live_mode only after production validation
# DODO_SOLO_PRODUCT_ID="pdt_..."
# Where Dodo returns the customer after checkout. Must be /checkout/return: that
# page reports what the verified webhook stored and never grants access itself.
# DODO_PAYMENTS_RETURN_URL="https://your-app.example/checkout/return"
# Optional. Defaults to the origin of DODO_PAYMENTS_RETURN_URL + /onboarding.
# DODO_PAYMENTS_CANCEL_URL="https://your-app.example/onboarding"
# DODO_PAYMENTS_WEBHOOK_SECRET="whsec_..."
# BUSINESS_SESSION_SECRET="generate-a-long-random-secret"

# Register https://your-app.example/api/webhooks/dodo in Dodo Dashboard →
# Developer → Webhooks. Subscribe at minimum to: subscription.active,
# subscription.updated, subscription.past_due, subscription.on_hold,
# subscription.cancelled, subscription.failed, subscription.expired,
# payment.succeeded, and payment.failed. The URL must be reachable from Dodo —
# locally, that means running the tunnel in tools/ and using its https host.

# Public base URL of this app — used to build provider webhook URLs (Telnyx and
# Dograh must reach it, so "http://localhost:3000" will NOT work).
# Set it to your ngrok/tunnel host or callflow.biz.
# PUBLIC_BASE_URL="https://your-ngrok-host"

# --- CORS for API endpoints (comma-separated origins, or * ) ---
# Unset = "*" (any site's browser JS may call the API). Set an explicit list
# before going live. Matching is an exact string compare: no trailing slashes.
# Value to use in production, VPS or Render (see "Deploying" in README.md):
# CORS_ORIGINS="https://callflow.biz,https://www.callflow.biz"
# http://localhost:3000 is NOT needed here: the dashboard fetches /api/... from
# its own origin, and same-origin requests are not subject to CORS at all.
# Caveat: CORS limits browser JS from OTHER sites only. It authenticates nothing,
# so while APP_AUTH_TOKEN is unset the write endpoints remain reachable from
# non-browser clients no matter what this says.
# CORS_ORIGINS="*"

# --- SQLite database location ---
# Path to the database file. Defaults to ./data/callflow.db when unset, which is
# all you need for local dev AND for a local production test (npm run build &&
# npm run start behind a tunnel) — no DATABASE_PATH required.
# On hosts whose disk is wiped by every redeploy (Render, Vercel, Fly, Heroku,
# Kubernetes — auto-detected) the app refuses to open the database in production
# unless this is an absolute path OUTSIDE the project directory, so a bad value
# fails loudly with a 500 instead of quietly losing data (src/lib/database.ts).
# Running production mode on a host that is not auto-detected (e.g. this VPS) does
# NOT trigger that check by itself; opt in with DB_REQUIRE_PERSISTENT_PATH=1 to
# keep it. deploy/systemd/callflow.service sets that flag, so the VPS is protected.
# On the VPS, deploy/vps-bootstrap.sh writes the /var/data value below for you:
# DATABASE_PATH="./data/callflow.db"   # local dev only
# DATABASE_PATH="/var/data/callflow.db"
# DB_REQUIRE_PERSISTENT_PATH=1

# --- Debug logging ---
# Set to 1 (or true) to enable verbose console logging from src/lib. Unset by default.
# DEBUG=1

# --- Admin panel (app-manager only) ---
# Separate credential from any owner session: the admin panel at /admin uses its
# own cookie (callflow_admin_session, HttpOnly, SameSite=Strict, 8 hours) signed
# with ADMIN_SESSION_SECRET. An owner's callflow_business_session cookie is
# never valid there. BOTH values are required for the admin area to exist at
# all: with either one missing, /admin/* and /api/admin/* answer 404 and nobody
# can log in (fail closed). Real values belong only in /srv/callflow/.env.
# 1) Run `npm run admin:hash` (hidden input; prints ONLY the scrypt hash line).
# 2) Paste that line as the value below, on the VPS.
ADMIN_PASSWORD_HASH=
# openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Local dev/test scripts only — NOT needed on the VPS ---
# Every variable below is read by scripts/ tooling, not by the app at runtime,
# and each has a working default or is only needed for a one-off local
# operation. Nothing here has to exist in /srv/callflow/.env.
#   BASE_URL / CHROME_PATH
#       scripts/browser-test-setup.mjs (Playwright smoke test) and
#       scripts/simulate-telnyx-call.mjs. Defaults: http://localhost:3000 and
#       the standard Chrome install path.
#   CALLFLOW_BASE_URL
#       scripts/test-signup-flow.mjs / test-subscription-status.mjs /
#       test-trial-to-paid.mjs. Default: http://localhost:3000.
#   DOGRAH_API_BASE / DOGRAH_API_KEY / DOGRAH_MCP_URL / DOGRAH_WORKFLOW_ID
#       One-off Dograh wiring + debug scripts (scripts/wire-dograh-webhook.mjs,
#       scripts/dograh-mcp.mjs). Run them from the dev machine while pointing
#       the Dograh workflow's webhook at the live host; the server itself never
#       reads these. Defaults: https://app.dograh.com/api/v1 and the MCP URL.
